# Firefly single-process appliance — M18.6 relocatable production unit.
# Not installed by the staging tool. Owner activation: docs/m18-owner-acceptance-runbook.md
# Argument contract is shared with scripts/firefly-dialogue.sh via FIREFLY_PREFIX.
# Libraries resolve from the binary RUNPATH ($ORIGIN/../lib).

[Unit]
Description=Firefly Voice Assistant
Documentation=file:///opt/firefly/voice-assistant/current/share/firefly/doc/m18-relocatable-production-packaging.md
After=network-online.target sound.target
Wants=network-online.target
# Avoid rapid crash loops from bad config / missing model
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=firefly
Group=firefly
WorkingDirectory=/opt/firefly/voice-assistant/current
ExecStart=/opt/firefly/voice-assistant/current/bin/firefly-demo \
  --store /var/lib/firefly/store \
  --init-config /opt/firefly/voice-assistant/current/share/firefly/config/empty-home.json \
  --model /opt/firefly/voice-assistant/models/runtime/Qwen3-4B_W8A8_RK3588_3core.rkllm \
  --admin-model /opt/firefly/voice-assistant/models/admin/Qwen3-4B_W8A8_CTX4096_RK3588_3core.rkllm \
  --admin-bind 127.0.0.1 \
  --admin-port 8080 \
  --voice \
  --stt-model-dir /opt/firefly/voice-assistant/models/stt \
  --vad-model /opt/firefly/voice-assistant/models/vad/silero_vad.onnx \
  --audio-device plughw:CARD=Array,DEV=0 \
  --wake-enabled true \
  --wake-python /opt/firefly/voice-assistant/current/share/firefly/wake/python/bin/python \
  --wake-model /opt/firefly/voice-assistant/current/share/firefly/wake/amina-v3.tflite \
  --wake-cutoff 0.99 --wake-window 7 \
  --playback-device plughw:CARD=rockchipes8388,DEV=0
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=firefly-voice-assistant
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/firefly/store
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
