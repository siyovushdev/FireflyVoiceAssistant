      "last_line": 88,
      "text": "        result = subprocess.run(['fuser', '/dev/dri/card1', '/dev/snd/pcmC3D0c'],\n                                capture_output=True, text=True, timeout=5)\n        assert result.returncode in (0, 1), result.stderr\n        return sorted({int(p) for p in result.stdout.split()})\n\n    def current(self):\n        link = os.readlink(self.prefix / 'current')\n        assert link in ('releases/' + self.plan['old'], 'releases/' + self.plan['new']), link\n        return Path(link).name\n\n    def stop(self):\n        self.run(['systemctl', 'stop', self.unit], timeout=65)\n        self.free()\n\n    def free(self):\n        assert not self.owners(), 'NPU or microphone remains owned'\n        assert self.run(['systemctl', 'show', self.unit, '-p', 'MainPID', '--value']) == '0'\n"
    },
