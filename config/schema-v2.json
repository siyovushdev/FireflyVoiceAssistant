{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:firefly:configuration:v2",
    "title": "Firefly typed mock configuration v2",
    "type": "object",
    "properties": {
        "schema_version": {
            "type": "integer",
            "const": 2
        },
        "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "retired_ids": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 4096
        },
        "system": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "locale": {
                    "const": "ru-RU"
                },
                "interpretation_profile": {
                    "const": "legacy_m4_v1"
                }
            },
            "required": [
                "id",
                "name",
                "locale",
                "interpretation_profile"
            ],
            "additionalProperties": false
        },
        "rooms": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/room"
            },
            "minItems": 0,
            "maxItems": 64
        },
        "devices": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/device"
            },
            "minItems": 0,
            "maxItems": 128
        },
        "actions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/action"
            },
            "minItems": 0,
            "maxItems": 32
        },
        "safety": {
            "type": "object",
            "properties": {
                "restrictions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/restriction"
                    },
                    "minItems": 0,
                    "maxItems": 128
                }
            },
            "required": [
                "restrictions"
            ],
            "additionalProperties": false
        },
        "bindings": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/binding"
            },
            "minItems": 0,
            "maxItems": 256
        },
        "compatibility": {
            "type": "object",
            "properties": {
                "codec": {
                    "const": "compact_v1"
                },
                "light_action_id": {
                    "$ref": "#/$defs/id"
                },
                "light_targets": {
                    "type": "object",
                    "properties": {
                        "K": {
                            "$ref": "#/$defs/id"
                        },
                        "B": {
                            "$ref": "#/$defs/id"
                        },
                        "G": {
                            "$ref": "#/$defs/id"
                        },
                        "C": {
                            "$ref": "#/$defs/id"
                        }
                    },
                    "required": [
                        "K",
                        "B",
                        "G",
                        "C"
                    ],
                    "additionalProperties": false
                },
                "door_action_id": {
                    "$ref": "#/$defs/id"
                },
                "door_target_id": {
                    "$ref": "#/$defs/id"
                }
            },
            "required": [
                "codec",
                "light_action_id",
                "light_targets",
                "door_action_id",
                "door_target_id"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "schema_version",
        "revision",
        "retired_ids",
        "system",
        "rooms",
        "devices",
        "actions",
        "safety",
        "bindings",
        "compatibility"
    ],
    "additionalProperties": false,
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "parameter": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "type": {
                    "enum": [
                        "boolean",
                        "integer",
                        "number",
                        "string",
                        "enum"
                    ]
                },
                "required": {
                    "type": "boolean"
                },
                "description": {
                    "type": "string",
                    "maxLength": 256
                },
                "unit": {
                    "type": "string",
                    "maxLength": 32
                },
                "minimum": {
                    "type": "number",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                },
                "maximum": {
                    "type": "number",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                },
                "min_length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                },
                "max_length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                },
                "values": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "maxItems": 32
                }
            },
            "required": [
                "id",
                "name",
                "type",
                "required",
                "description",
                "unit"
            ],
            "additionalProperties": false
        },
        "room": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "speech": {
                    "type": "object",
                    "properties": {
                        "mentions": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 96
                            },
                            "minItems": 0,
                            "maxItems": 32
                        },
                        "locations": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 96
                            },
                            "minItems": 0,
                            "maxItems": 32
                        }
                    },
                    "required": [
                        "mentions",
                        "locations"
                    ],
                    "additionalProperties": false
                },
                "metadata": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 256
                        },
                        "aliases": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 96
                            },
                            "maxItems": 16
                        },
                        "parent_id": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "container": {
                            "type": "boolean"
                        },
                        "origin": {
                            "enum": [
                                "manual",
                                "local_ai",
                                "imported"
                            ]
                        },
                        "confirmed": {
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "name",
                "speech"
            ],
            "additionalProperties": false
        },
        "device": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "kind": {
                    "enum": [
                        "light",
                        "entrance_door",
                        "generic"
                    ]
                },
                "room_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                },
                "action_ids": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/id"
                    },
                    "minItems": 0,
                    "maxItems": 32
                },
                "spoken_aliases": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "maxItems": 32
                },
                "metadata": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "description": {
                            "type": "string",
                            "maxLength": 256
                        },
                        "aliases": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 96
                            },
                            "maxItems": 16
                        },
                        "origin": {
                            "enum": [
                                "manual",
                                "local_ai",
                                "imported"
                            ]
                        },
                        "confirmed": {
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                },
                "state": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/state_field"
                    },
                    "maxItems": 16
                }
            },
            "required": [
                "id",
                "name",
                "kind",
                "room_id",
                "enabled",
                "action_ids",
                "spoken_aliases",
                "state"
            ],
            "additionalProperties": false
        },
        "action": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "operation": {
                    "enum": [
                        "light.set_brightness.v1",
                        "entrance_door.open.v1",
                        "mock.assign.v1"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                },
                "parameters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/parameter"
                    },
                    "minItems": 0,
                    "maxItems": 16
                },
                "speech_aliases": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "maxItems": 32
                },
                "description": {
                    "type": "string",
                    "maxLength": 256
                },
                "assignments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/assignment"
                    },
                    "maxItems": 16
                },
                "origin": {
                    "enum": [
                        "manual",
                        "local_ai",
                        "imported"
                    ]
                }
            },
            "required": [
                "id",
                "name",
                "operation",
                "enabled",
                "parameters",
                "speech_aliases",
                "description",
                "assignments"
            ],
            "additionalProperties": false
        },
        "restriction": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "kind": {
                    "const": "deny_action"
                },
                "device_id": {
                    "$ref": "#/$defs/id"
                },
                "action_id": {
                    "$ref": "#/$defs/id"
                }
            },
            "required": [
                "id",
                "name",
                "kind",
                "device_id",
                "action_id"
            ],
            "additionalProperties": false
        },
        "state_field": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "type": {
                    "enum": [
                        "boolean",
                        "integer",
                        "number",
                        "string",
                        "enum"
                    ]
                },
                "required": {
                    "type": "boolean"
                },
                "description": {
                    "type": "string",
                    "maxLength": 256
                },
                "unit": {
                    "type": "string",
                    "maxLength": 32
                },
                "minimum": {
                    "type": "number",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                },
                "maximum": {
                    "type": "number",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                },
                "min_length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                },
                "max_length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1024
                },
                "values": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                    },
                    "maxItems": 32
                },
                "initial": {
                    "type": [
                        "boolean",
                        "integer",
                        "number",
                        "string"
                    ]
                }
            },
            "required": [
                "id",
                "name",
                "type",
                "required",
                "description",
                "unit",
                "initial"
            ],
            "additionalProperties": false
        },
        "assignment": {
            "type": "object",
            "properties": {
                "field": {
                    "$ref": "#/$defs/id"
                },
                "argument": {
                    "$ref": "#/$defs/id"
                },
                "value": {
                    "type": [
                        "boolean",
                        "integer",
                        "number",
                        "string"
                    ]
                }
            },
            "required": [
                "field"
            ],
            "additionalProperties": false
        },
        "http_binding": {
            "type": "object",
            "properties": {
                "method": {
                    "enum": [
                        "POST",
                        "PUT"
                    ]
                },
                "url": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 512,
                    "description": "http://IPv4[:port]/path — numeric IPv4 only; DNS hostnames rejected because getaddrinfo is not covered by the HTTP socket deadline"
                },
                "timeout_ms": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 10000
                },
                "content_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "body": {
                    "type": "object"
                },
                "argument": {
                    "$ref": "#/$defs/id"
                }
            },
            "required": [
                "method",
                "url",
                "timeout_ms"
            ],
            "additionalProperties": false
        },
        "binding": {
            "type": "object",
            "properties": {
                "target_id": {
                    "$ref": "#/$defs/id"
                },
                "action_id": {
                    "$ref": "#/$defs/id"
                },
                "executor": {
                    "enum": [
                        "http"
                    ]
                },
                "http": {
                    "$ref": "#/$defs/http_binding"
                }
            },
            "required": [
                "target_id",
                "action_id",
                "executor",
                "http"
            ],
            "additionalProperties": false
        }
    }
}
